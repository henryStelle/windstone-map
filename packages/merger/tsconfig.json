{
    "compilerOptions": {
        "target": "ES2023",
        "lib": [
            "ES2023"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": [
            "node"
        ],
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "skipLibCheck": true
    },
    "include": [
        "src"
    ]
}